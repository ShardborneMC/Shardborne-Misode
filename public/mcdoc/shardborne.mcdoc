use ::java::data::worldgen::processor_list::ProcessorListRef
use ::java::data::worldgen::template_pool::ElementBase
use ::java::world::component::DataComponentPatch
use ::java::data::advancement::AdvancementCriterion
use ::java::data::advancement::trigger::Conditions
use ::java::data::util::IntRange
use ::java::data::advancement::trigger::CompositeEntity

// Theme
dispatch minecraft:resource[shardborne:dungeon/themes] to struct Theme {
	processor:  #[id="worldgen/processor_list"] string,
	weight: float @ 1..100,
	generation_type: ("maze" | "open_world"),
	biome: #[id(registry="worldgen/biome")] string,
	structures: ThemeStructureEntry,
	theme_settings_id: string
}

struct ThemeStructureEntry {
	[#[id="worldgen/structure"] string]: ThemeStructure
}

struct ThemeStructure {
	min?: int,
	max?: int,
}


// Template Pool
dispatch minecraft:template_pool_element[shardborne:dungeon_pool_element] to struct TemplatePool {
	...ElementBase,
	location: #[id="structure"] string,
	processors: [string],
	allow_overlap?:boolean,
	is_room?:boolean,
	disable_block_replacement?:boolean,
}


// Mob Spawning
dispatch minecraft:resource[shardborne:dungeon/mob_spawning] to [MobSpawningStruct]

struct MobSpawningStruct {
	id:string,
	groups: [GroupStruct],
	max_spawn_cost:int,
	min_spawn_cost:int,
}

struct GroupStruct {
	group_id:string,
	weight: int
}

// Mob Groups
dispatch minecraft:resource[shardborne:dungeon/mob_groups] to struct MobGroup {
	group_name:string,
	spawn_cost:int,
	mobs: [MobDefinition]
}

struct MobDefinition {
	weight:int,
	mob_id: #[id="entity_type"] string,
}

// NPC
dispatch minecraft:resource[shardborne:custom_npc] to struct NPC {
	quests: struct { [string] : Quests },
	prerequisites?: [Prerequisites],
	random_dialogue: struct {[#[id] NPCs]: RandomDialogue}
}


enum(string) NPCs {
	Wisp="shardborne:wisp",
	Meld="shardborne:meld",
	Sage="shardborne:sage",
	Juuno="shardborne:juuno",
	Aldhor="shardborne:aldhor",
	Stooch="shardborne:stooch",
	Ander="shardborne:ander",
}


struct Quests {
	/// The entity id of the npc for this quest 
	npc: NPCs,
	/// If true, this quest can be skipped ahead to if its requirements are met early. Default is false 
	skip_ahead_if_complete?: boolean,
	/// Dialogue for after this quest has been completed. This can be omitted as long as satisfied dialogue exists OR this isn't the last quest in the quest line with this npc
	finished_dialogue?: [DialogueType],
	/// The initial dialogue for the quest which will only show once - once it is complete it will show either the satisfied or unsatisfied dialogue depending on if the requirements are met
	initial_dialogue: [DialogueType] @ 1..,
	/// The requirements for completed this quest. If omitted, the quest will complete after initial dialogue
	requirements?: [Requirements] @ 1..,
	/// Dialogue for once requirements are met. If omitted, the next quest will start automatically instead  
	satisfied_dialogue?: [DialogueType],
	/// Dialogue for after initial dialogue and before requirements are met. Can be omitted if requirements is also omitted
	unsatisfied_dialogue?: [DialogueType] @ 1..,
}

dispatch shardborne:prerequisites_type[shardborne:level] to struct LevelRequirement {
	level:int
}
dispatch shardborne:prerequisites_type[shardborne:questline] to struct {
	questlines:[string]
}

type DialogueType = ([string] | DialogueSection)

struct DialogueSection {
	lines: [string],
	companions?: [IDialogueCompanion],
}

struct IDialogueCompanion {
	type: ("shardborne:display_item"|"shardborne:give_item"|"shardborne:give_recipes"|"shardborne:reveal_npc_name"|"shardborne:unlock_theme"|"shardborne:open_gui"),
	...shardborne:dialogue_type[[type]],
}

/// This companion displays an `ItemStack` above the dialogue box while the player is reading its section. 
dispatch shardborne:dialogue_type[shardborne:display_item] to struct {
	 ...ItemStack
}

dispatch shardborne:dialogue_type[shardborne:give_item] to struct {
	...ItemStack
}

dispatch shardborne:dialogue_type[shardborne:give_recipes] to struct {
	recipes: [#[id="recipe"] string]
}

dispatch shardborne:dialogue_type[shardborne:unlock_theme] to struct {
	theme: string	
}

dispatch shardborne:dialogue_type[shardborne:open_gui] to struct {
	gui: string
}

struct ItemStack {
	id: #[id="item"] string,
	count?: int,
	components?: DataComponentPatch 
}

type Requirements = (CriterionList | CriterionAndCount | AdvancementCriterion)

struct CriterionList {
	criteria: [CriterionAndCount] @ 1..,
	grouping: [string]
}

struct CriterionAndCount {
	criterion: AdvancementCriterion,
	/// How many times the criterion must be triggered before being considered complete
	trigger_count?: int
}

type Prerequisites = (PrerequisitesList | AdvancementCriterion)

struct PrerequisitesList {
	criteria: [AdvancementCriterion] @ 1..,
	grouping: [string]
}


dispatch shardborne:requirement_type[shardborne:carry_item, shardborne:make_recipe] to struct {
	item: ItemStack
}

dispatch shardborne:requirement_type[shardborne:enter_dimension] to struct {
	dimension: #[id="dimension"] string 
}

struct RandomDialogue {
	initial?: [DialogueType] @ 1..,
	dialogue_pool: [[DialogueType]] @ 1..
}

// Processors

dispatch minecraft:template_processor[shardborne:spawner_block_processor] to struct {
	spawner_group:string
}

dispatch minecraft:template_processor[shardborne:block_replacement_processor] to struct {
	input_block:#[id="block"] string,
	output_block:#[id="block"] string,
	probability?:float @ 0..1,
}

dispatch minecraft:template_processor[shardborne:foliage_replacement_processor] to struct {
	input_block:#[id="block"] string,
	output_block:#[id="block"] string,
	probability?:float @ 0..1,
}

dispatch minecraft:template_processor[shardborne:dungeon_room_processor] to struct {
	target:#[id="block"] string,
	success_replacement:#[id="block"] string,
	fail_replacement?:#[id="block"] string,
	min_blocks: int,
	max_blocks: int,
	replacement_chance: float @ 0..1,
}

// Loot Conditions

dispatch minecraft:loot_condition[shardborne:dungeon_level] to struct {
	range: IntRange
}

dispatch minecraft:loot_condition[shardborne:dungeon_category] to struct {
	value: string
}

dispatch minecraft:loot_condition[shardborne:dungeon] to struct {
	level?: IntRange,
	themes?: [#[id] string]
}

dispatch minecraft:loot_condition[shardborne:near_structure] to struct {
	structures: (#[id=(registry="worldgen/structure",tags="allowed")] string | [#[id="worldgen/structure"] string]),
}

// Trigger Types

dispatch minecraft:trigger[shardborne:player_level_up] to Conditions<struct {
	level: IntRange,
	player?: CompositeEntity
}>

dispatch minecraft:trigger[shardborne:complete_quest_line] to Conditions<struct {
	quest_lines: [string],
	player?: CompositeEntity
}>
